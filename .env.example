# Book-forge 환경 설정 예시
# book-forge init 을 실행하면 이 값들이 대화형으로 채워집니다.

# LLM_PROVIDER: ollama | openai | anthropic  (기본값 ollama — API 키 없이 로컬 실행)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI 사용 시
# OPENAI_API_KEY=sk-proj-...

# Anthropic 사용 시
# ANTHROPIC_API_KEY=sk-ant-...

# 선택 — RAG 소스 수집 시 웹 검색 (M5)
# SERPER_API_KEY=...
